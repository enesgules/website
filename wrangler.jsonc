{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enesgules",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-23",
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/og-video.mp4"]
  }
}
